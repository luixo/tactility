{
  "name": "tactility",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "db:generate": "kysely-codegen",
    "db:migrate": "kysely migrate latest --experimental-resolve-tsconfig-paths",
    "dev": "vite dev",
    "format": "prettier --write .",
