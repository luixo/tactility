{
	"name": "tactility",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"db:generate": "kysely-codegen",
		"db:migrate": "kysely migrate latest --experimental-resolve-tsconfig-paths",
		"dev": "vite dev",
		"format": "oxfmt --write",
		"format:verify": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"lint-staged": "lint-staged",
		"start": "srvx --prod -s ../client dist/server/server.js",
		"typecheck": "bun check"
	},
	"dependencies": {
		"@heroui/react": "3.0.0-beta.2",
		"@heroui/styles": "3.0.0-beta.2",
