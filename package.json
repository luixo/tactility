		"@types/pg": "^8.16.0",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"dotenv-cli": "^11.0.0",
		"eslint": "^9.39.2",
		"kysely-codegen": "^0.19.0",
		"kysely-ctl": "^0.19.0",
		"lint-staged": "^17.6.0",
		"oxfmt": "0.73.0",
		"oxlint": "1.88.0",
		"oxlint-tsgolint": "7.0.2004",
		"pre-commit": "^2.0.0",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vite": "^8.0.0-beta.2",
